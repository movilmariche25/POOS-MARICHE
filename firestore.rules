rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Helpers de Autenticación y Roles
     */
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /**
     * Gestión de Roles Globales
     */
    match /roles_admin/{adminId} {
      allow get: if true;
      allow read, write: if false; 
    }

    /**
     * Anuncios del Sistema
     */
    match /system/announcements {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /**
     * Estructura Multi-Tenant
     */
    match /users/{userId} {
      // Permitimos get público para validar la existencia del taller durante el login
      allow get: if true;
      allow list: if isAdmin();
      
      // Permitimos crear/actualizar si el usuario es el dueño
      // Importante: No usamos isOwner aquí directamente para permitir el "handshake" inicial de sesión
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();

      match /{allData=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}