{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil del usuario y configuración de su taller.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "businessName": { "type": "string" },
        "licenseStatus": { "type": "string", "enum": ["active", "trial", "expired"] },
        "licenseExpiry": { "type": "string", "format": "date-time" },
        "isAdmin": { "type": "boolean" },
        "lastSessionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "sku": { "type": "string" },
        "costPrice": { "type": "number" },
        "stockLevel": { "type": "number" },
        "reservedStock": { "type": "number" },
        "damagedStock": { "type": "number" }
      }
    },
    "RepairJob": {
      "title": "RepairJob",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerID": { "type": "string" },
        "customerAddress": { "type": "string" },
        "status": { "type": "string" },
        "amountPaid": { "type": "number" },
        "estimatedCost": { "type": "number" }
      }
    },
    "Sale": {
      "title": "Sale",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "totalAmount": { "type": "number" },
        "transactionDate": { "type": "string" }
      }
    },
    "DailyReconciliation": {
      "title": "DailyReconciliation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "totalSales": { "type": "number" },
        "totalDifference": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "description": "Perfil del taller."
        }
      },
      {
        "path": "/users/{userId}/products/{productId}",
        "definition": {
          "entityName": "Product",
          "description": "Inventario del taller."
        }
      },
      {
        "path": "/users/{userId}/repair_jobs/{jobId}",
        "definition": {
          "entityName": "RepairJob",
          "description": "Trabajos técnicos."
        }
      },
      {
        "path": "/users/{userId}/sale_transactions/{saleId}",
        "definition": {
          "entityName": "Sale",
          "description": "Ventas y abonos."
        }
      }
    ]
  }
}